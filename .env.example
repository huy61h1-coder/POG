# PostgreSQL connection string supplied by Vibe Host. Leave blank only for local demo mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Vibe Host normally provides PORT. Set it only for a custom local port.
PORT=3000

# Directory used for uploaded POG PDF/image files.
UPLOAD_DIR=./data/uploads

# Optional persistent directory for JSON data when PostgreSQL is unavailable.
# In production, use an absolute persistent volume outside the app checkout,
# for example DATA_DIR=/var/lib/pog/data. Do not use ./data for production.
DATA_DIR=./data

# Optional first Admin for a new deployment. Use a strong secret password in Vibe Host.
# If omitted, the one-time setup screen creates the first Admin.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Quản trị hệ thống

# OpenAI key used only by the server for product recommendations. Never expose it as a VITE_* variable.
OPENAI_API_KEY=

# Fast OpenAI API model with Structured Outputs support for grounded recommendations.
OPENAI_MODEL=gpt-5-mini

# Optional limits for AI requests.
AI_RATE_LIMIT=8
AI_PRODUCT_LIMIT=800

# Cloudinary signed image uploads (keep the API secret server-side only).
# Create these values in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder in the Cloudinary Media Library.
CLOUDINARY_FOLDER=products
