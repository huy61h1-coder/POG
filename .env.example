# PostgreSQL connection string supplied by Vibe Host. Leave blank only for local demo mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Vibe Host normally provides PORT. Set it only for a custom local port.
PORT=3000

# Directory used for uploaded POG PDF/image files.
UPLOAD_DIR=./data/uploads

# Optional persistent directory for local JSON data when PostgreSQL is unavailable.
DATA_DIR=./data

# Optional first Admin for a new deployment. Use a strong secret password in Vibe Host.
# If omitted, the one-time setup screen creates the first Admin.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Quản trị hệ thống

# OpenAI key used only by the server for product recommendations. Never expose it as a VITE_* variable.
OPENAI_API_KEY=

# Fast model with Structured Outputs support for grounded recommendations.
OPENAI_MODEL=gpt-5.4-mini

# Optional limits for AI requests.
AI_RATE_LIMIT=8
AI_PRODUCT_LIMIT=800
